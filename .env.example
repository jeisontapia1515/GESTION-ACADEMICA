# Puerto del servidor web
PORT=3000

# Cadena de conexión a MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.spl1slo.mongodb.net/efim_decanatura?appName=Cluster0

# Clave secreta para generación de tokens JWT
JWT_SECRET=tu_clave_secreta_jwt_para_produccion

# Tiempo de expiración de sesión JWT
JWT_EXPIRES_IN=7d

# Entorno de ejecución (development o production)
NODE_ENV=production

# URL pública del aplicativo desplegado en la web (opcional; si se omite, se detecta dinámicamente)
# APP_URL=https://gestionacademica-esfim.up.railway.app

# Claves VAPID para notificaciones Web Push (generar con: npx web-push generate-vapid-keys)
# VAPID_SUBJECT=mailto:eduardo.puello@esfim.edu.co
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
