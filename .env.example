# Puerto del servidor web
PORT=3000

# Cadena de conexión a MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.spl1slo.mongodb.net/efim_decanatura?appName=Cluster0

# Clave secreta para generación de tokens JWT
JWT_SECRET=tu_clave_secreta_jwt_para_produccion

# Tiempo de expiración de sesión JWT
JWT_EXPIRES_IN=7d

# Entorno de ejecución (development o production)
NODE_ENV=production

# URL pública del aplicativo desplegado en la web (opcional; si se omite, se detecta dinámicamente)
# APP_URL=https://gestionacademica-esfim.up.railway.app

# Claves VAPID para notificaciones Web Push (generar con: npx web-push generate-vapid-keys)
# VAPID_SUBJECT=mailto:eduardo.puello@esfim.edu.co
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Correo SMTP Institucional para despacho automático al delegar compromisos y recordatorios
# Configure estas variables en las Variables de Entorno de Render (o en su archivo .env local):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=eduardo.puello@esfim.edu.co
SMTP_PASS=tu_contrasena_o_app_password_m365
SMTP_FROM=eduardo.puello@esfim.edu.co
SMTP_FROM_NAME="Decanatura de Investigación - ESFIM"

# Opcional: cuentas separadas para Decano y Gestor si se desean remitentes diferentes
# DECANO_SMTP_USER=juan.perdomo@esfim.edu.co
# DECANO_SMTP_PASS=tu_clave_m365_decano
# GESTOR_SMTP_USER=eduardo.puello@esfim.edu.co
# GESTOR_SMTP_PASS=tu_clave_m365_gestor
